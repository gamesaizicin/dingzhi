    if object:IsA("Model") then
        if object.PrimaryPart then
            return object.PrimaryPart.Position
        else
            return object:GetPivot().Position
        end
    elseif object:IsA("BasePart") then
        return object.Position
    end
    return nil
end

local function handleAvoidance()
    if not isEnabled then return end
    
    local character = localPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not rootPart or not humanoid then return end
    
    for _, v in ipairs(game.Workspace:GetDescendants()) do
        if (v:IsA("Model") or v:IsA("BasePart")) and string.sub(v.Name, 1, 9) == "Leviathan" then
            local entityPos = getEntityPosition(v)
            if entityPos then
                local currentPos = rootPart.Position
                local distance = (currentPos - entityPos).Magnitude
                
                if distance < avoidDistance then
                    local direction = (currentPos - entityPos).Unit
                    if direction.Y ~= direction.Y then direction = Vector3.new(0, 0, 1) end
                    
                    local targetPosition = entityPos + (direction * (avoidDistance + 5))
                    rootPart.CFrame = CFrame.new(Vector3.new(targetPosition.X, currentPos.Y, targetPosition.Z), Vector3.new(entityPos.X, currentPos.Y, entityPos.Z))
                end
            end
        end
    end
end

