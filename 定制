local function GetHighlight(target, color)
	local name = "ESP_" .. target.Name
	local highlight = ESPFolder:FindFirstChild(name)
	
	if not highlight or highlight.Adornee ~= target then
		if highlight then highlight:Destroy() end
		highlight = Instance.new("Highlight")
		highlight.Name = name
		highlight.Adornee = target
		highlight.FillTransparency = 0.7
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = ESPFolder
	end
	
	highlight.FillColor = color
	highlight.OutlineColor = color
	highlight.Enabled = true
end

local function ClearInvalidESP()
	for _, highlight in ipairs(ESPFolder:GetChildren()) do
		if highlight:IsA("Highlight") then
			if not highlight.Adornee or not highlight.Adornee.Parent then
				highlight:Destroy()
			end
		end
	end
end

local function RemoveESP(target)
	local highlight = ESPFolder:FindFirstChild("ESP_" .. target.Name)
	if highlight then
		highlight:Destroy()
	end
end

local function UpdateESP()
	ClearInvalidESP()

	if MonsterESPEnabled then
		local balor = Workspace.Camera:FindFirstChild("BalorHallucination")
		if balor then
			GetHighlight(balor, Color3.fromRGB(255, 0, 0))
		end

		local monstersFolder = Workspace:FindFirstChild("CurrentMonsters")
		if monstersFolder then
			for _, monster in ipairs(monstersFolder:GetChildren()) do
				GetHighlight(monster, Color3.fromRGB(255, 0, 0))
			end
		end
	else
		local balor = Workspace.Camera:FindFirstChild("BalorHallucination")
		if balor then RemoveESP(balor) end
		
		local monstersFolder = Workspace:FindFirstChild("CurrentMonsters")
		if monstersFolder then
			for _, monster in ipairs(monstersFolder:GetChildren()) do
				RemoveESP(monster)
			end
		end
	end

	if PlayerESPEnabled then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				GetHighlight(player.Character, Color3.fromRGB(0, 255, 0))
			end
		end
	else
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				RemoveESP(player.Character)
			end
		end
	end
end

