local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")
 
local LocalPlayer = Players.LocalPlayer
local ESP_FOLDER_NAME = "__animatronics_esp"
local ESP_TAG_NAME = "__animatronics_highlight"
 
local espConnection
local puppetConnection
local puppetReturnCFrame
 
local function getCharacter()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart")
    return character, humanoidRootPart
end
 
local function getAnimatronicsFolder()
    return Workspace:FindFirstChild("Animatronics")
end
 
local function getPuppet()
    local animatronics = getAnimatronicsFolder()
    if not animatronics then
        return nil
    end
 
    return animatronics:FindFirstChild("Puppet")
end
 
local function getEspFolder()
    local folder = CoreGui:FindFirstChild(ESP_FOLDER_NAME)
    if folder then
        return folder
    end
 
    folder = Instance.new("Folder")
    folder.Name = ESP_FOLDER_NAME
    folder.Parent = CoreGui
    return folder
end
 
local function isRenderableEntity(instance)
    return instance and (instance:IsA("Model") or instance:IsA("BasePart"))
end
 
local function getEntityKey(instance)
    return instance:GetDebugId()
end
 
local function getHighlightFor(instance)
    local folder = CoreGui:FindFirstChild(ESP_FOLDER_NAME)
    if not folder then
        return nil
    end
 
    local key = getEntityKey(instance)
    return folder:FindFirstChild(key)
end
 
local function configureHighlight(highlight, target)
    highlight.Name = getEntityKey(target)
    highlight:SetAttribute(ESP_TAG_NAME, true)
    highlight.Adornee = target
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
    highlight.Enabled = true
    highlight.Parent = getEspFolder()
end
 
local function ensureHighlight(target)
    if not isRenderableEntity(target) or not target.Parent then
        return
    end
 
    local current = getHighlightFor(target)
    if current and current:IsA("Highlight") then
        local valid = current.Adornee == target
            and current.Parent == getEspFolder()
            and current.OutlineColor == Color3.fromRGB(255, 0, 0)
            and current.FillTransparency == 1
            and current.OutlineTransparency == 0
            and current.DepthMode == Enum.HighlightDepthMode.AlwaysOnTop
 
        if valid then
            current.Enabled = true
            return
        end
 
        current:Destroy()
    end
 
    local highlight = Instance.new("Highlight")
    configureHighlight(highlight, target)
end
 
local function clearEsp()
    local folder = CoreGui:FindFirstChild(ESP_FOLDER_NAME)
    if folder then
        folder:Destroy()
    end
end
 
local function refreshAnimatronicsEsp()
    local animatronics = getAnimatronicsFolder()
    if not animatronics then
        clearEsp()
        return
    end
 
    local aliveKeys = {}
 
    for _, child in ipairs(animatronics:GetChildren()) do
        if isRenderableEntity(child) then
            aliveKeys[getEntityKey(child)] = true
            ensureHighlight(child)
        end
    end
 
    local folder = CoreGui:FindFirstChild(ESP_FOLDER_NAME)
    if not folder then
        return
    end
 
    for _, item in ipairs(folder:GetChildren()) do
        if item:IsA("Highlight") and not aliveKeys[item.Name] then
            item:Destroy()
        end
    end
end
 
local function setEspEnabled(state)
    if espConnection then
        espConnection:Disconnect()
        espConnection = nil
    end
 
    if not state then
        clearEsp()
        return
    end
 
    refreshAnimatronicsEsp()
 
    espConnection = RunService.Heartbeat:Connect(function()
        pcall(refreshAnimatronicsEsp)
    end)
end
 
local function findPrompts(root)
    local prompts = {}
 
    if not root then
        return prompts
    end
 
    for _, descendant in ipairs(root:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            table.insert(prompts, descendant)
        end
    end
 
    return prompts
end
 
local function getGroundedPosition(basePosition, ignoreList)
    local origin = basePosition + Vector3.new(0, 12, 0)
    local direction = Vector3.new(0, -40, 0)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = ignoreList
 
    local result = Workspace:Raycast(origin, direction, params)
    if result then
        return result.Position + Vector3.new(0, 3.5, 0)
    end
 
    return basePosition + Vector3.new(0, 3.5, 0)
end
 
local function getSafePuppetCFrame()
    local puppet = getPuppet()
    if not puppet then
        return nil
    end
 
    local _, humanoidRootPart = getCharacter()
    local pivot = puppet:IsA("Model") and puppet:GetPivot() or puppet.CFrame
    local forward = pivot.LookVector
    local candidate = pivot.Position + forward * 6
    local grounded = getGroundedPosition(candidate, {puppet, LocalPlayer.Character})
    return CFrame.lookAt(grounded, pivot.Position)
end
 
local function teleportTo(cframe)
    local character, humanoidRootPart = getCharacter()
    character:PivotTo(cframe)
    humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
    humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
end
 
local function fireAllPuppetPrompts()
    local puppet = getPuppet()
    if not puppet then
        return
    end
 
    local prompts = findPrompts(puppet)
    for _, prompt in ipairs(prompts) do
        pcall(function()
            fireproximityprompt(prompt)
        end)
    end
end
 
local function setPuppetPromptEnabled(state)
    if puppetConnection then
        puppetConnection:Disconnect()
        puppetConnection = nil
    end
 
    if not state then
        if puppetReturnCFrame then
            pcall(function()
                teleportTo(puppetReturnCFrame)
            end)
        end
 
        puppetReturnCFrame = nil
        return
    end
 
    local _, humanoidRootPart = getCharacter()
    puppetReturnCFrame = humanoidRootPart.CFrame
 
    local safeCFrame = getSafePuppetCFrame()
    if safeCFrame then
        pcall(function()
            teleportTo(safeCFrame)
        end)
    end
 
    pcall(fireAllPuppetPrompts)
 
    puppetConnection = RunService.Heartbeat:Connect(function()
        pcall(function()
            local currentSafeCFrame = getSafePuppetCFrame()
            if currentSafeCFrame then
                teleportTo(currentSafeCFrame)
            end
 
            fireAllPuppetPrompts()
        end)
    end)
end
 
