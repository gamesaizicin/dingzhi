local function GetLidParts(root, list)
	list = list or {}
	for _, desc in ipairs(root:GetDescendants()) do
		if desc:IsA("ProximityPrompt") and desc.Enabled then
			local part = desc.Parent
			if part and part:IsA("BasePart") then
				local nameLower = string.lower(part.Name)
				local parentNameLower = part.Parent and string.lower(part.Parent.Name) or ""
				if string.find(nameLower, "chest") or string.find(nameLower, "treasure") or string.find(parentNameLower, "chest") or string.find(parentNameLower, "treasure") then
					table.insert(list, part)
				end
			end
		end
	end
	return list
end

local function FirePrompt(prompt)
	if fireproximityprompt then
		fireproximityprompt(prompt)
	else
		task.spawn(function()
			prompt:InputBegan(Enum.UserInputType.MouseButton1)
			task.wait(prompt.HoldDuration + 0.05)
			prompt:InputEnded(Enum.UserInputType.MouseButton1)
		end)
	end
end

local function CheckNearbyPrompts(rootPart)
	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("ProximityPrompt") and desc.Enabled then
			local parentPart = desc.Parent
			if parentPart and parentPart:IsA("BasePart") then
				local d = (rootPart.Position - parentPart.Position).Magnitude
				if d <= 5 then
					return desc
				end
			end
		end
	end
	return nil
end

local function TeleportPlayer(pos)
