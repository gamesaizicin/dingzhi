local function CreateESP(object)
    if not object:FindFirstChild("Highlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "Highlight"
        hl.FillTransparency = 1
        hl.OutlineColor = Color3.fromRGB(255, 105, 180)
        hl.OutlineTransparency = 0
        hl.Adornee = object
        hl.Parent = object
    end
    
    if not object:FindFirstChild("ESPWatcher") then
        local watcher = Instance.new("BoolValue")
        watcher.Name = "ESPWatcher"
        watcher.Parent = object
        
        task.spawn(function()
            while object:FindFirstChild("ESPWatcher") and object.Parent do
                task.wait(1)
                local currentHl = object:FindFirstChild("Highlight")
                if not currentHl or currentHl.OutlineColor ~= Color3.fromRGB(255, 105, 180) then
                    if currentHl then currentHl:Destroy() end
                    local hl = Instance.new("Highlight")
                    hl.Name = "Highlight"
                    hl.FillTransparency = 1
                    hl.OutlineColor = Color3.fromRGB(255, 105, 180)
                    hl.OutlineTransparency = 0
                    hl.Adornee = object
                    hl.Parent = object
                end
            end
        end)
    end
end

local function RemoveESP(object)
    local hl = object:FindFirstChild("Highlight")
    local watcher = object:FindFirstChild("ESPWatcher")
    if hl then hl:Destroy() end
    if watcher then watcher:Destroy() end
end

local states = {
    Giver_Coins = false,
    BasicBlueprint = false,
    Battery = false,
    Flares = false
}

local function checkAndApply(object)
    for suffix, enabled in pairs(states) do
        if string.find(object.Name, suffix) then
            if enabled then
                CreateESP(object)
            else
                RemoveESP(object)
            end
            break
        end
    end
end

Workspace.DescendantAdded:Connect(function(descendant)
    if descendant:IsA("BasePart") or descendant:IsA("Model") then
        checkAndApply(descendant)
    end
end)

local function toggleESPType(suffix, state)
    states[suffix] = state
    for _, v in ipairs(Workspace:GetDescendants()) do
        if (v:IsA("BasePart") or v:IsA("Model")) and string.find(v.Name, suffix) then
            if state then
                CreateESP(v)
            else
                RemoveESP(v)
            end
        end
    end
end

